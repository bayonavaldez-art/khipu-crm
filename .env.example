# Variables de entorno — copiar a .env y ajustar los valores.
# NUNCA subir el .env real al repositorio (está en .gitignore).

# Secreto para firmar los JWT (generar uno propio con: openssl rand -hex 32)
SECRET_KEY=cambiar-este-secreto-en-produccion

# Minutos de validez del token de sesión (8 horas por defecto)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Base de datos: SQLite para desarrollo local.
# En Render/Railway usar la URL de PostgreSQL que provee la plataforma.
DATABASE_URL=sqlite:///./khipu_crm.db

# Días sin interacción para generar alertas de seguimiento (RF03)
ALERTA_DIAS_SIN_INTERACCION=7
